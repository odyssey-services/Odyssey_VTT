<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Odyssey.Persistence</AssemblyName>
    <RootNamespace>Odyssey.Persistence</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Odyssey.Domain.csproj" />
    <ProjectReference Include="Odyssey.Content.csproj" />
    <ProjectReference Include="Odyssey.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-011 v1.1 section 1: accepted SQLite provider library, pinned with the
         SQLitePCLRaw.bundle_e_sqlite3 >= 3.0.3 floor required to resolve the
         NuGet-audit-flagged vulnerability in the default 2.1.x transitive chain. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Packages\com.odyssey.persistence\Runtime\**\*.cs" />
  </ItemGroup>
</Project>
