{
  "schemaVersion": 1,
  "eventCodes": [
    {
      "eventCode": "runtime.starting",
      "ownerSubsystem": "runtime",
      "defaultLogLevel": "Information",
      "allowedProperties": [
        { "key": "phase", "classification": "Operational" }
      ],
      "purpose": "Runtime startup began.",
      "status": "Active"
    },
    {
      "eventCode": "runtime.ready",
      "ownerSubsystem": "runtime",
      "defaultLogLevel": "Information",
      "allowedProperties": [
        { "key": "state", "classification": "Operational" },
        { "key": "duration_ms", "classification": "Duration" }
      ],
      "purpose": "Runtime reached Ready.",
      "status": "Active"
    },
    {
      "eventCode": "runtime.startup_failed",
      "ownerSubsystem": "runtime",
      "defaultLogLevel": "Error",
      "allowedProperties": [
        { "key": "phase", "classification": "Operational" },
        { "key": "reason", "classification": "Operational" }
      ],
      "purpose": "Runtime startup failed safely.",
      "status": "Active"
    },
    {
      "eventCode": "runtime.shutdown_requested",
      "ownerSubsystem": "runtime",
      "defaultLogLevel": "Information",
      "allowedProperties": [
        { "key": "state", "classification": "Operational" }
      ],
      "purpose": "Runtime shutdown was requested.",
      "status": "Active"
    },
    {
      "eventCode": "runtime.shutdown_completed",
      "ownerSubsystem": "runtime",
      "defaultLogLevel": "Information",
      "allowedProperties": [
        { "key": "duration_ms", "classification": "Duration" }
      ],
      "purpose": "Runtime shutdown completed.",
      "status": "Active"
    },
    {
