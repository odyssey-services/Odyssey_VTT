        { "key": "sink", "classification": "Operational" },
        { "key": "diagnostic_id", "classification": "TechnicalIdentifier" }
      ],
      "purpose": "A diagnostics sink failed and fallback handled the event.",
      "status": "Active"
    },
    {
      "eventCode": "diagnostics.probe",
      "ownerSubsystem": "diagnostics",
