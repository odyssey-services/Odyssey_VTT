      "purpose": "DeveloperShell probe command was accepted.",
      "status": "Active"
    },
    {
      "eventCode": "developer.probe_rejected",
      "ownerSubsystem": "developer",
      "defaultLogLevel": "Warning",
      "allowedProperties": [
        { "key": "command_id", "classification": "TechnicalIdentifier" },
        { "key": "result_status", "classification": "Operational" }
